# Etape 2 : CT elastoplastique en petites deformations, deformations planes. Unites : N, mm, MPa.
import json

DEBUT(LANG="FR")

with open("fort.30") as handle:
    PARAMS = json.load(handle)

MA = LIRE_MAILLAGE(FORMAT="ASTER", UNITE=20)
MA = DEFI_GROUP(
    reuse=MA,
    MAILLAGE=MA,
    CREA_GROUP_NO=_F(GROUP_MA=("LIGAMENT", "LEVRE", "TROU_HAUT", "SOLIDE")),
)
MO = AFFE_MODELE(
    MAILLAGE=MA,
    AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION=PARAMS["modelisation"]),
)

COURBE = [value for point in PARAMS["courbe"] for value in point]
TRAC = DEFI_FONCTION(
    NOM_PARA="EPSI", NOM_RESU="SIGM", VALE=COURBE, PROL_DROITE="CONSTANT", PROL_GAUCHE="EXCLU",
)
ACIER = DEFI_MATERIAU(ELAS=_F(E=PARAMS["E"], NU=PARAMS["nu"]), TRACTION=_F(SIGM=TRAC))
CM = AFFE_MATERIAU(MAILLAGE=MA, AFFE=_F(TOUT="OUI", MATER=ACIER))

APPUIS = AFFE_CHAR_MECA(
    MODELE=MO,
    DDL_IMPO=(_F(GROUP_MA="LIGAMENT", DY=0.0), _F(GROUP_NO="BLOC_X", DX=0.0)),
)
# Pseudo-temps = P/B en N/mm : la charge unitaire est multipliee par l'instant courant.
EFFORT = AFFE_CHAR_MECA(
    MODELE=MO,
    FORCE_CONTOUR=_F(GROUP_MA="TROU_HAUT", FY=PARAMS["traction_unitaire"]),
)
RAMPE = DEFI_FONCTION(NOM_PARA="INST", VALE=(0.0, 0.0, 1.0, 1.0), PROL_DROITE="LINEAIRE")

L_REEL = DEFI_LIST_REEL(VALE=PARAMS["instants"])
L_INST = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=L_REEL),
    ECHEC=_F(ACTION="DECOUPE", SUBD_METHODE="MANUEL", SUBD_PAS=2, SUBD_NIVEAU=4),
)

RES = STAT_NON_LINE(
    MODELE=MO,
    CHAM_MATER=CM,
    EXCIT=(_F(CHARGE=APPUIS), _F(CHARGE=EFFORT, FONC_MULT=RAMPE)),
    COMPORTEMENT=_F(RELATION="VMIS_ISOT_TRAC", DEFORMATION="PETIT"),
    INCREMENT=_F(LIST_INST=L_INST),
    NEWTON=_F(REAC_INCR=1, REAC_ITER=1, MATRICE="TANGENTE"),
    CONVERGENCE=_F(RESI_GLOB_RELA=1.0e-6, ITER_GLOB_MAXI=30),
    ARCHIVAGE=_F(LIST_INST=L_REEL),
)
RES = CALC_CHAMP(
    reuse=RES,
    RESULTAT=RES,
    FORCE="REAC_NODA",
    CONTRAINTE="SIEF_ELNO",
    VARI_INTERNE="VARI_ELNO",
)

FORMAT = dict(FORMAT="TABLEAU", FORMAT_R="E17.10")

REAC = POST_RELEVE_T(
    ACTION=_F(INTITULE="REACTION", OPERATION="EXTRACTION", GROUP_NO="LIGAMENT", RESULTAT=RES,
              NOM_CHAM="REAC_NODA", RESULTANTE="DY", TOUT_ORDRE="OUI")
)
IMPR_TABLE(TABLE=REAC, UNITE=38, **FORMAT)

DEPL_ARC = POST_RELEVE_T(
    ACTION=_F(INTITULE="ARC", OPERATION="EXTRACTION", GROUP_NO="TROU_HAUT", RESULTAT=RES,
              NOM_CHAM="DEPL", NOM_CMP="DY", TOUT_ORDRE="OUI")
)
IMPR_TABLE(TABLE=DEPL_ARC, UNITE=41, **FORMAT)

LIG = POST_RELEVE_T(
    ACTION=(
        _F(INTITULE="SIG", OPERATION="EXTRACTION", GROUP_NO="LIGAMENT", RESULTAT=RES,
           NOM_CHAM="SIEF_ELNO", NOM_CMP="SIYY", TOUT_ORDRE="OUI"),
        _F(INTITULE="VAR", OPERATION="EXTRACTION", GROUP_NO="LIGAMENT", RESULTAT=RES,
           NOM_CHAM="VARI_ELNO", NOM_CMP="V1", TOUT_ORDRE="OUI"),
    )
)
IMPR_TABLE(TABLE=LIG, UNITE=42, **FORMAT)

# Deformation plastique sur toute la piece, a quelques niveaux de charge, pour mesurer la zone plastique.
ZP = POST_RELEVE_T(
    ACTION=_F(INTITULE="ZP", OPERATION="EXTRACTION", GROUP_NO="SOLIDE", RESULTAT=RES,
              NOM_CHAM="VARI_ELNO", NOM_CMP="V1", NUME_ORDRE=PARAMS["ordres_zp"])
)
IMPR_TABLE(TABLE=ZP, UNITE=43, **FORMAT)

FOND = DEFI_FOND_FISS(
    MAILLAGE=MA,
    SYME="OUI",
    FOND_FISS=_F(GROUP_NO="POINTE"),
    LEVRE_SUP=_F(GROUP_MA="LEVRE"),
)
for r_inf, r_sup in PARAMS["contours"]:
    TG = CALC_G(
        THETA=_F(FISSURE=FOND, R_INF=r_inf, R_SUP=r_sup),
        RESULTAT=RES,
        TOUT_ORDRE="OUI",
        OPTION="G",
    )
    IMPR_TABLE(TABLE=TG, UNITE=39, **FORMAT)
    DETRUIRE(NOM=TG)

FIN()
